   "source": [
    "columns = ['Happiness score', 'log_gdp', 'Healthy life expectancy', 'Social support']\n",
    "cleaned = df[columns]\n",
    "\n",
    "\n",
    "cleaned = cleaned.replace(np.inf, np.nan)\n",
    "cleaned = cleaned.replace(-np.inf, np.nan)\n",
    "cleaned = cleaned.dropna()\n",
    "\n",
    "\n",
    "print(\"Rows and columns:\", cleaned.shape)\n",
    "stats = cleaned.describe()\n",
    "print(stats)"
   ]
