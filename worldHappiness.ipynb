   "source": [
    "y = cleaned['Happiness score']\n",
    "X = cleaned[['log_gdp', 'Healthy life expectancy', 'Social support']]\n",
    "\n",
    "X = sm.add_constant(X)\n",
    "\n",
    "model = sm.OLS(y, X).fit()\n",
    "print(model.summary())"
   ]
  },
